# ============================================================
# API Keys
# ============================================================

# Gemini API Key (for both OCR and LLM)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Qwen API Key (for LLM)
# Get your key from: https://dashscope.console.aliyun.com/
QWEN_API_KEY=your_qwen_api_key_here

# ============================================================
# Service Configuration
# ============================================================

# OCR Service Selection
# Options: gemini, chandra
OCR_SERVICE=gemini

# LLM Service Selection
# Options: gemini, qwen
LLM_SERVICE=gemini

# ============================================================
# OCR Service URLs
# ============================================================

# Chandra OCR API URL
# Default: http://localhost:8000
CHANDRA_API_URL=http://localhost:8000

# ============================================================
# LLM Service URLs & Models
# ============================================================

# Qwen Base URL (OpenAI-compatible endpoint)
# Alibaba Cloud DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# Local vLLM: http://localhost:8000/v1
# Local TGI: http://localhost:8080/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model Configuration (Optional - uses service defaults if not set)
# Gemini Models: gemini-3-flash-preview, gemini-2.0-flash-exp, gemini-1.5-pro
GEMINI_MODEL=gemini-3-flash-preview

# Qwen Models: qwen-turbo, qwen-plus, qwen-max, qwen-2.5-72b-instruct
QWEN_MODEL=qwen-turbo

# ============================================================
# LLM Generation Settings (Optional)
# ============================================================

# Default temperature for LLM generation (0.0 to 2.0)
# Lower = more focused, Higher = more creative
LLM_TEMPERATURE=0.0

# Maximum tokens to generate per response
# LLM_MAX_TOKENS=2048
